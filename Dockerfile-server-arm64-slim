FROM python:3.10-slim

# 安装最小化系统包（不安装完整 ffmpeg）
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libopus0 \
    locales && \
    sed -i '/zh_CN.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    # 清理不需要的文件
    rm -rf /usr/share/doc /usr/share/man && \
    # 创建假的 ffmpeg 脚本通过启动检查（pydub 实际未被使用）
    printf '#!/bin/sh\necho "ffmpeg version 0.0.0 (stub for startup check)"\n' > /usr/local/bin/ffmpeg && \
    chmod +x /usr/local/bin/ffmpeg

ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    PYTHONIOENCODING=utf-8

WORKDIR /opt/xiaozhi-esp32-server

COPY requirements-arm64.txt requirements.txt
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    # 移除运行时不需要的包
    pip uninstall -y sympy mpmath && \
    pip cache purge && \
    rm -rf /root/.cache/pip && \
    # 移除不需要的包管理工具
    pip uninstall -y pip setuptools wheel 2>/dev/null || true

COPY main/xiaozhi-server .
RUN mkdir -p tmp data

EXPOSE 8000 8003
CMD ["python", "app.py"]
