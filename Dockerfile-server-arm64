# 音频解码走 PyAV（wheel 自带 ffmpeg 库），不装系统 ffmpeg。
# Debian 的 ffmpeg 包会经 libavfilter/libplacebo/libsdl2 拉进 libLLVM(118M)、
# libgallium(34M)、libz3(26M) 等图形栈，实测 202 个包 / 419 MB，而本服务只用
# 它读 wav 和 mp3（core/utils/util.py 的 decode_to_pcm）。
#
# sympy/mpmath 是 onnxruntime 的声明依赖，只被 onnxruntime.transformers 的
# 符号形状推理用到，推理路径不碰，卸掉省 57 MB。

FROM python:3.10-slim

RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    libopus0 locales && \
    sed -i '/zh_CN.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man

ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    PYTHONIOENCODING=utf-8

WORKDIR /opt/xiaozhi-esp32-server

COPY requirements-arm64.txt requirements.txt
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip uninstall -y sympy mpmath

COPY main/xiaozhi-server .
RUN mkdir -p tmp data

EXPOSE 8000 8003
CMD ["python", "app.py"]
